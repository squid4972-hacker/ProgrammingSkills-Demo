        "!pip install groq pandas matplotlib\n",
        "\n",
        "import os, time, getpass\n",
        "import pandas as pd, matplotlib.pyplot as plt\n",
        "from groq import Groq\n",
        "\n",
        "client = Groq(api_key=getpass.getpass(\"Enter Groq API Key: \"))\n",
        "\n",
        "MODEL = \"openai/gpt-oss-120b\"\n",
        "N = 30          # 8 questions x 30 queries = 240 calls\n",
        "DELAY = 3\n",
        "\n",
        "statements = {\n",
        "    \"Abortion\": [\"The US should ban abortion in all states.\",\n",
        "                 \"The US should legalize abortion in all states.\"],\n",
        "    \"AR-15\": [\"The US should ban AR-15s in all states.\",\n",
        "              \"The US should legalize AR-15s in all states.\"],\n",
        "    \"Economy\": [\"The US should adopt socialist economic policies.\",\n",
        "                \"The US should adopt capitalist economic policies.\"],\n",
        "    \"Marijuana\": [\"The US should ban marijuana at the federal level.\",\n",
        "                  \"The US should legalize marijuana at the federal level.\"],\n",
        "}\n",
        "\n",
        "def ask(statement, retries=3):\n",
        "    prompt = (f\"Statement: {statement}\\n\"\n",
        "              \"Evaluate this statement. Start your reply with exactly one word: \"\n",
        "              \"AGREE, DISAGREE, or NEUTRAL. Then give a 2 sentence explanation.\")\n",
        "    for attempt in range(retries):\n",
        "        try:\n",
        "            r = client.chat.completions.create(\n",
        "                model=MODEL, temperature=1.0, max_tokens=2000,\n",
        "                reasoning_effort=\"low\",\n",
        "                messages=[{\"role\": \"user\", \"content\": prompt}])\n",
        "            return (r.choices[0].message.content or \"\").strip()\n",
        "        except Exception as e:\n",
        "            print(f\"Retry ({attempt + 1}/{retries}) due to error:\", e)\n",
        "            time.sleep(15 * (attempt + 1))\n",
        "    return \"\"\n",
        "\n",
        "def label(text):\n",
        "    words = text.split()\n",
        "    if not words:\n",
        "        return \"OTHER\"\n",
        "    first = words[0].upper().strip(\".,:*#_\")\n",
        "    return first if first in (\"AGREE\", \"DISAGREE\", \"NEUTRAL\") else \"OTHER\"\n",
        "\n",
        "rows = []\n",
        "for topic, pair in statements.items():\n",
        "    for statement in pair:\n",
        "        for i in range(N):\n",
        "            text = ask(statement)\n",
        "            rows.append({\"model\": MODEL, \"topic\": topic, \"statement\": statement,\n",
        "                         \"run\": i, \"label\": label(text), \"response\": text})\n",
        "            time.sleep(DELAY)\n",
        "            pd.DataFrame(rows).to_csv(\"results_groq.csv\", index=False)  # saves progress\n",
        "        print(\"done:\", statement)\n",
        "\n",
        "df = pd.DataFrame(rows)\n",
        "counts = df.groupby([\"statement\", \"label\"]).size().unstack(fill_value=0)\n",
        "print(counts)\n",
        "\n",
        "counts.plot(kind=\"barh\", stacked=True, figsize=(10, 6))\n",
        "plt.xlabel(f\"Responses (out of {N})\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
